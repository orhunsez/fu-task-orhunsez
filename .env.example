# Kopyala: cp .env.example .env
# Buradaki değerler sadece local geliştirme içindir, secret değildir.
# Prod değerleri (Neon DATABASE_URL vb.) yalnızca Vercel environment variable'larında durur.

# --- Postgres (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks

# --- Backend ---
# Backend'i docker dışında (uv run ...) çalıştırırken kullanılır.
# docker compose içinde bu değer compose dosyasında "db" servisine göre yeniden kurulur.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tasks
# Virgülle ayrılmış izinli frontend origin'leri
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
